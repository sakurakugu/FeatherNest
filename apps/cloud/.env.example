# === PostgreSQL ===
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=blogdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bloguser:change_me_in_production@postgres:5432/blogdb

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === 认证 ===
AUTH_SECRET_KEY=replace-with-a-very-long-random-string
# 首次创建生产账号前必须填写至少 12 位的独立密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SESSION_EXPIRE_DAYS=30
AUTH_SESSION_COOKIE_NAME=session_id
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=.sakurakugu.com
# 原生 App 连接云端接口时属于跨站场景，需要 none 才能发送登录 Cookie
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true

# === MinIO (兼容 S3) ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blog-uploads
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=https://api.sakurakugu.com/files

# === App ===
APP_ENV=production # development or production
APP_DEBUG=false
# 经反向代理部署时，填写可信代理所在的内部网段；禁止填写 *
# FORWARDED_ALLOW_IPS=127.0.0.1,172.20.0.0/16
# 生产默认只放行站点域名和 capacitor://localhost；开发启动脚本单独配置 localhost
# 手机或桌面壳连接生产 API 如确需其他来源，请显式填写准确的 JSON 数组
CORS_ORIGINS=
SITE_URL=https://www.sakurakugu.com

# === 文娱外部数据源 ===
# 仅作用于文娱外部搜索、详情读取和封面下载；留空时不读取系统 HTTP_PROXY/HTTPS_PROXY
# 示例：http://host.docker.internal:7890 或 http://10.66.0.2:8888
MEDIA_EXTERNAL_HTTP_PROXY=
MEDIA_EXTERNAL_REQUEST_TIMEOUT_SECONDS=8

# === 博客静态生成（构建期使用匿名公开 API） ===
SSG_API_BASE_URL=https://www.sakurakugu.com/api/v1

# === Twikoo（页面通过同源 /twikoo 访问） ===
TWIKOO_DATA_DIR=/app/twikoo-data
TWIKOO_CONTAINER_NAME=feathernest-twikoo-1
TWIKOO_CONTAINER_DATA_DIR=/app/data
DOCKER_SOCKET_PATH=/var/run/docker.sock

